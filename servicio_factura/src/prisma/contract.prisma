// use prisma-8

model Factura {
  id            ObjectId   @id @map("_id")
  codigo        String     @unique
  fecha         Date
  cod_cliente   Int32
  total         Double
  descuento     Double
  iva           Double
  total_a_pagar Double

  detalles_facturas DetalleFactura[]
  @@map("facturas")
}

type DetalleFactura{
  codigo Int32
  cod_producto Int32
  cantidad Int32
  subtotal Double
  precio Double
}